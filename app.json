{
  "expo": {
    "name": "SVADBA.kz",
    "slug": "svadba-mobile",
    "scheme": "svadbakz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.svadbakz.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.svadbakz.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A1114",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите Svadba выбирать фото и видео для портфолио.",
          "cameraPermission": "Разрешите Svadba снимать фото для портфолио.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "161426eb-a676-4e53-bf96-4d1f0de929eb"
      }
    },
    "owner": "kairkuka"
  }
}
