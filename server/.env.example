SENDGRID_API_KEY=SG_REPLACE_WITH_REAL_KEY
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=SVADBA.kz
# Optional fallback if SendGrid is unavailable or credits are exhausted.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SVADBA.kz
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Optional comma-separated override for every accepted Google OAuth client id.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
EXPO_PUBLIC_SENTRY_TEST_ENABLED=0
# Built-in fallback when Sentry is not configured. Requires CloudWatch log metric filters/alarms.
CLIENT_ERROR_MONITORING=cloudwatch
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SMOKE_API_BASE_URL=https://svadba.kz/api
SMOKE_CLIENT_EMAIL=client-test@example.com
SMOKE_CLIENT_PASSWORD=replace-with-client-test-password
SMOKE_VENDOR_EMAIL=vendor-test@example.com
SMOKE_VENDOR_PASSWORD=replace-with-vendor-test-password
SMOKE_MEDIA_FILE=
APPLE_CLIENT_ID=com.svadbakz.app
APPLE_BUNDLE_ID=com.svadbakz.app
# Optional comma-separated override for every accepted Apple token audience.
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Escaped multiline .p8 contents: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_PRIVATE_KEY=
# Encrypts provider refresh tokens stored in the application state.
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-plus-random-chars
PUBLIC_BASE_URL=https://svadba.kz
CORS_ALLOWED_ORIGIN=https://svadba.kz
DATA_DIR=/data
DATABASE_URL=postgresql://user:password@host:5432/svadba
DATABASE_SSL=1
DATABASE_STATE_KEY=svadba-main
DATABASE_LOCK_KEY=svadba-state:svadba-main
DB_LOCAL_BACKUPS=1
DB_LOCAL_BACKUP_LIMIT=25
DB_BACKUP_INTERVAL_MS=60000
DB_BACKUP_STORAGE=s3
DB_BACKUP_BUCKET=svadba-prod-db-backups
DB_BACKUP_PREFIX=db-backups
UPLOADS_STORAGE=s3
S3_UPLOAD_BUCKET=svadba-prod-uploads
S3_UPLOAD_PREFIX=uploads
UPLOADS_PUBLIC_BASE_URL=https://media.svadba.kz
AWS_REGION=eu-central-1
MAX_INSTAGRAM_DOWNLOAD_BYTES=157286400
MAX_USER_UPLOAD_BYTES=536870912
MAX_VIDEO_DURATION_SECONDS=60
MEDIA_TOOL_TIMEOUT_MS=120000
MAX_JSON_BODY_BYTES=1048576
MAX_INSTAGRAM_MEDIA_ITEMS=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
UGC_RATE_LIMIT_WINDOW_MS=3600000
UGC_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=120
BOOKING_RATE_LIMIT_WINDOW_MS=3600000
BOOKING_RATE_LIMIT_MAX=60
CLIENT_ERROR_RATE_LIMIT_WINDOW_MS=900000
CLIENT_ERROR_RATE_LIMIT_MAX=60
MODERATION_ADMIN_TOKEN=replace-with-long-random-token
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://d2ne1y5a2elsg5.cloudfront.net/api/instagram/callback
INSTAGRAM_SCOPE=instagram_business_basic
INSTAGRAM_GRAPH_VERSION=v24.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://d2ne1y5a2elsg5.cloudfront.net/api/instagram/facebook-callback
FACEBOOK_INSTAGRAM_SCOPE=pages_show_list,pages_read_engagement,instagram_basic
FACEBOOK_GRAPH_VERSION=v24.0
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-with-random-instagram-webhook-token
INSTAGRAM_TOKEN_ENCRYPTION_KEY=replace-with-32-plus-random-chars
# Local/dev only. Do not enable in production.
ALLOW_TEST_AUTH=0
TEST_AUTH_USERS=
TEST_AUTH_PASSWORD=
